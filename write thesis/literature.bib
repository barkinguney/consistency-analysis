	keywords = {IDT UQ},
	pages = {1175--1182},
	file = {PDF:C\:\\Users\\barki\\Zotero\\storage\\DXH8K4WT\\Davidson et al. - 2005 - Shock tube ignition measurements of iso-octaneair and tolueneair at high pressures.pdf:application/pdf},
}

