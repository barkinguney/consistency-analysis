@article{slavinskaya_development_2017,
	title = {Development of an {Uncertainty} {Quantification} {Predictive} {Chemical} {Reaction} {Model} for {Syngas} {Combustion}},
	volume = {31},
	issn = {0887-0624, 1520-5029},
	url = {https://pubs.acs.org/doi/10.1021/acs.energyfuels.6b02319},
	doi = {10.1021/acs.energyfuels.6b02319},
	abstract = {An automated data-centric infrastructure, Process Informatics Model (PrIMe), was applied to validation and optimization of a syngas combustion model. The Bound-to-Bound Data Collaboration (B2BDC) module of PrIMe was employed to discover the limits of parameter modiﬁcations based on uncertainty quantiﬁcation (UQ) and consistency analysis of the model−data system and experimental data, including shock-tube ignition delay times and laminar ﬂame speeds. Existing syngas reaction models are reviewed, and the selected kinetic data are described in detail. Empirical rules were developed and applied to evaluate the uncertainty bounds of the literature experimental data. The initial H2/CO reaction model, assembled from 73 reactions and 17 species, was subjected to a B2BDC analysis. For this purpose, a dataset was constructed that included a total of 167 experimental targets and 55 active model parameters. Consistency analysis of the composed dataset revealed disagreement between models and data. Further analysis suggested that removing 45 experimental targets, 8 of which were self-inconsistent, would lead to a consistent dataset. This dataset was subjected to a correlation analysis, which highlights possible directions for parameter modiﬁcation and model improvement. Additionally, several methods of parameter optimization were applied, some of them unique to the B2BDC framework. The optimized models demonstrated improved agreement with experiments compared to the initially assembled model, and their predictions for experiments not included in the initial dataset (i.e., a blind prediction) were investigated. The results demonstrate beneﬁts of applying the B2BDC methodology for developing predictive kinetic models.},
	language = {en},
	number = {3},
	urldate = {2026-02-11},
	journal = {Energy \& Fuels},
	author = {Slavinskaya, N. A. and Abbasi, M. and Starcke, J. H. and Whitside, R. and Mirzayeva, A. and Riedel, U. and Li, W. and Oreluk, J. and Hegde, A. and Packard, A. and Frenklach, M. and Gerasimov, G. and Shatalov, O.},
